generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ClassRole {
  SKARBNIK
  RODZIC
  NAUCZYCIEL
  PRZEWODNICZACY
  ZASTEPCA
}

enum SystemRole {
  USER
  ADMIN
}

enum Gender {
  KOBIETA
  MEZCZYZNA
  NIE_PODANO
}

enum TransactionType {
  PRZYCHOD
  WYDATEK
}

model User {
  id           String    @id @default(cuid())
  login        String    @unique
  email        String    @unique
  passwordHash String
  name         String
  surname      String
  role         SystemRole @default(USER)
  createdAt    DateTime  @default(now())
  ownedClasses Class[]   @relation("ClassOwner")
  taughtClasses Class[]  @relation("ClassTeacher")
  chairedClasses Class[] @relation("ClassChairperson")
  deputyClasses  Class[] @relation("ClassDeputy")
  classMemberships ClassMembership[]
}

model Class {
  id             String       @id @default(cuid())
  name           String
  schoolYear     String       @default("2025/2026")
  description    String?
  teacher        String
  teacherId      String?
  chairpersonName String?
  deputyName     String?
  ownerId        String
  chairpersonId  String?
  deputyId       String?
  owner          User         @relation("ClassOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  teacherUser    User?        @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  chairperson    User?        @relation("ClassChairperson", fields: [chairpersonId], references: [id], onDelete: SetNull)
  deputy         User?        @relation("ClassDeputy", fields: [deputyId], references: [id], onDelete: SetNull)
  members        ClassMembership[]
  students       Student[]
  collections    Collection[]
  transactions   Transaction[]
  createdAt      DateTime     @default(now())
}

model ClassMembership {
  classId  String
  userId   String
  role     ClassRole
  class    Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  user     User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
  @@index([userId])
}

model Student {
  id           String              @id @default(cuid())
  firstName    String
  lastName     String
  parent1      String?
  parent2      String?
  parent1Phone String?
  parent2Phone String?
  parent1Mail  String?
  parent2Mail  String?
  gender       Gender              @default(NIE_PODANO)
  active       Boolean             @default(true)
  classId      String
  class        Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  contributions Contribution[]
  collections  Collection[]
  transactions Transaction[]
}

model Collection {
  id          String         @id @default(cuid())
  name        String
  schoolYear  String
  startsAt    DateTime
  endsAt      DateTime
  target      Decimal        @db.Decimal(10, 2)
  spent       Decimal        @default(0) @db.Decimal(10, 2)
  classId     String
  class       Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  students    Student[]
  contributions Contribution[]
  transactions Transaction[]
}

model Transaction {
  id              String          @id @default(cuid())
  referenceNumber String          @unique
  bank            String
  transactionDate DateTime
  title           String
  amount          Decimal         @db.Decimal(10, 2)
  type            TransactionType
  classId         String
  collectionId    String?
  studentId       String?
  class           Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  collection      Collection?     @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  student         Student?        @relation(fields: [studentId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())

  @@index([classId, transactionDate])
}

model Contribution {
  id           String      @id @default(cuid())
  bankId       String?     @unique
  amount       Decimal     @db.Decimal(10, 2)
  paidAt       DateTime    @default(now())
  studentId    String
  collectionId String
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  collection   Collection  @relation(fields: [collectionId], references: [id], onDelete: Cascade)
}
